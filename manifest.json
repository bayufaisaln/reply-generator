{
  "manifest_version": 3,
  "name": "Reply Fb",
  "version": "1.6",
  "description": "Ambil data produk Shopee, download gambar, dan buat balasan singkat (READY, dsb) untuk komentar FB Group.",
  "permissions": ["activeTab", "downloads", "storage"],
  "host_permissions": [
    "*://shopee.co.id/*",
    "*://shopee.com/*",
    "https://*.susercontent.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://api.codebuddy.com/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "Reply Fb" },
  "content_scripts": [
    {
      "matches": ["*://shopee.co.id/*", "*://shopee.com/*"],
      "js": ["content.js"]
    }
  ]
}
